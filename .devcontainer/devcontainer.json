{
  "name": "Simulador Integral de Sistema Contable",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postStartCommand": "bash .devcontainer/arrancar.sh",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Simulador Contable",
      "onAutoForward": "openPreview",
      "visibility": "private",
      "protocol": "http"
    }
  },
  "remoteEnv": {
    "HOST": "0.0.0.0",
    "PORT": "5000",
    "SIMULADOR_DEBUG": "0",
    "SESSION_COOKIE_SECURE": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.eol": "\n"
      }
    }
  },
  "waitFor": "postCreateCommand"
}
