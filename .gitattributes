# Normalización de finales de línea.
# Los scripts de shell DEBEN viajar con LF aunque se editen en Windows:
# con CRLF, bash en el VPS falla con "bad interpreter: /bin/bash^M".
* text=auto

*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
Procfile      text eol=lf

*.cmd         text eol=crlf
*.bat         text eol=crlf
*.ps1         text eol=crlf

*.png         binary
*.jpg         binary
*.xlsx        binary
*.db          binary
