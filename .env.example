# =============================================================================
#  Simulador Integral de Sistema Contable — variables de entorno
# =============================================================================
#  Cómo usarlo:
#    · Desarrollo (Windows/Linux):  copie este archivo como  .env  en la raíz del
#      proyecto y ajuste los valores. El archivo .env NO se publica en Git.
#    · Producción (VPS): el instalador escribe estas mismas variables en
#      /etc/simulador/secrets.env y el servicio las carga con EnvironmentFile.
#      También puede definirlas en el panel del hosting.
#
#  NINGÚN dominio, clave ni ruta de datos está fijada en el código: todo se
#  configura aquí. El dominio se define al instalar (--dominio) y en Nginx.
# =============================================================================

# --- Seguridad (OBLIGATORIO cambiarlo en producción) -------------------------
# Genere una clave nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-64-caracteres

# "1" cuando el sitio se sirve por HTTPS (obligatorio con Let's Encrypt).
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=session
SESSION_HORAS=8
# Tamaño máximo de archivo que se puede subir como evidencia (MB).
MAX_CONTENT_MB=16

# --- Datos (base de CONTROL, aulas de los estudiantes y plantilla) -----------
# En el VPS se recomienda /var/datos (fuera de la carpeta del código, para que
# las actualizaciones del sistema no toquen los datos).
DATABASE_PATH=/var/datos/simulator.db
RUTA_AULAS=/var/datos/aulas
RUTA_PLANTILLA=/var/datos/plantilla/aula_base.db

# --- Servidor ---------------------------------------------------------------
# 127.0.0.1 cuando hay Nginx por delante (nunca lo exponga directo a Internet).
HOST=127.0.0.1
PORT=8080
